# =============================================================================
# Payment System - Environment Configuration
# Copy this file to .env and change every secret before deploying.
#   cp project/.env.example project/.env
# NEVER commit the real .env file.
# =============================================================================

# --- Database / infra credentials ---
POSTGRES_USER=microservices
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_mongo_password
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- Application secrets (shared between services, CHANGE ALL) ---
# Legacy password hashing key (only used to verify legacy HMAC hashes)
APP_SECRET_KEY=CHANGE_ME_app_secret_key
# API key ms-payment uses to call ms-paymentagr
PARTNER_API_KEY=CHANGE_ME_partner_api_key
# HMAC secret used to sign/verify payment callbacks between ms-paymentagr and ms-payment
NOTIFY_SECRET=CHANGE_ME_notify_secret

# --- URLs ---
# Public URL used by ms-paymentagr to build checkout (redirect) links
PUBLIC_BASE_URL=http://localhost:8081
# Internal callback target (monolith, Go-only)}
NOTIFY_URL=http://monolith:8085/ms/api/v1/payment/notify
# Callback URLs used by the frontend
FRONTEND_URL=http://localhost:3000

# --- Frontend (Go-only: pointed at monolith) ---
MS_ORDER_URL=http://monolith:8085
MS_PAYMENT_URL=http://monolith:8085

# --- Misc ---
SESSION_TTL_SECONDS=1800
CORS_ALLOWED_ORIGINS=http://localhost:3000
